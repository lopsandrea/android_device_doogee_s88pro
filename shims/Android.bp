// vtservice, from the stock Android 10 system image, is a 32-bit binary in
// /system/bin: so is its shim. See vtservice.cpp.
cc_library_shared {
    name: "libshim_vtservice",
    srcs: ["vtservice.cpp"],
    compile_multilib: "32",
    shared_libs: [
        "framework-permission-aidl-cpp",
        "libaudioclient",
        "libbinder",
        "libgui",
        "liblog",
        "libstagefright",
        "libstagefright_foundation",
        "libui",
        "libutils",
    ],
}
