# The EAS boost applier: see rootdir/etc/init/s88pro-schedtune.rc for what it
# does and why it has to exist at all.
#
# It needs a domain of its own for one reason: init refuses to start a service
# that would stay in the init domain.
#
#   init: Command 'start s88pro_schedtune' ... failed: Could not start service:
#     File /system/bin/sh (labeled "u:object_r:shell_exec:s0") has incorrect
#     label or no domain transition from u:r:init:s0 to another SELinux domain
#     defined.
#
# That is what naming the interpreter as the service executable costs, and it
# is silent: the refusal goes to /dev/kmsg, where the kernel rate-limits init's
# output away, and the only visible symptom is an empty init.svc property.
type s88pro_schedtune, domain, coredomain;
type s88pro_schedtune_exec, system_file_type, exec_type, file_type;
init_daemon_domain(s88pro_schedtune)

# The interpreter named in the shebang, and the applets the script runs:
# sleep and cat are toybox, log is its own binary.
allow s88pro_schedtune shell_exec:file rx_file_perms;
allow s88pro_schedtune toolbox_exec:file rx_file_perms;
allow s88pro_schedtune logcat_exec:file rx_file_perms;

# The boosts themselves, under /dev/stune. Write and read back -- the script
# reapplies until the value holds. Not create: AOSP neverallows that for every
# domain (system/sepolicy/private/domain.te).
allow s88pro_schedtune cgroup:dir search;
allow s88pro_schedtune cgroup:file { open read write getattr };
