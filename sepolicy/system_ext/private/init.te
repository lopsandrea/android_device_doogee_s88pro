#
# init creates the sockets declared in the vendor .rc files. The VoLTE and BIP
# ones carry no explicit context, so they inherit socket_device:
#
#   denied { create } for name="volte_imsa2" scontext=u:r:init:s0
#     tcontext=u:object_r:socket_device:s0 tclass=sock_file
#
# The others are volte_ut and vendor.bip.
allow init socket_device:sock_file { create setattr unlink };

