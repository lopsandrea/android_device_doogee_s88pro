#
# The reverse charging node deserves a type of its own.
#
# It starts out as generic sysfs, and nobody may write to that: it is forbidden
# to system domains (coredomain.te:141) and even to init, with a comment saying
# how to do it instead --
#
#   # Init should not access sysfs node that are not explicitly labeled.
#   neverallow init sysfs:file { open write };
#
# -- that is, by labelling it. Once that is done, the only prohibition left on
# sysfs_type:file concerns untrusted apps (app_neverallows.te:100), and
# S88ProParts is not one of those.
type sysfs_rvs, fs_type, sysfs_type;

# /system/bin/vtservice. Its domain and the type the stock ROM gave its binary
# are the vendor policy's, which the build cannot see; this type is joined to
# that domain in compat/29.0/29.0.compat.cil.
type vtservice_s88pro_exec, system_file_type, exec_type, file_type;

# /sys/class/tp_gesture, the touch driver's gesture switches. It
# needs a type for the same reason as the reverse charging node above: as
# generic sysfs neither init, which changes its owner on post-fs-data, nor the
# HALs that write it (power and touch) may touch it.
type sysfs_tp_gesture, fs_type, sysfs_type;
