#
# The reverse charging node deserves a type of its own.
#
# It starts out as generic sysfs, and nobody may write to that: it is forbidden
# to system domains (coredomain.te:141) and even to init, with a comment saying
# how to do it instead --
#
#   # Init should not access sysfs node that are not explicitly labeled.
#   neverallow init sysfs:file { open write };
#
# -- that is, by labelling it. Once that is done, the only prohibition left on
# sysfs_type:file concerns untrusted apps (app_neverallows.te:100), and
# S88ProParts is not one of those.
type sysfs_rvs, fs_type, sysfs_type;
