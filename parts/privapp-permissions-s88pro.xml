<permissions>
    <!--
         Privileged apps have to list here the signature|privileged level
         permissions they request in their manifest. This is not a formality:
         if the entry is missing, PermissionManagerService raises an
         IllegalStateException in systemReady() and system_server does not
         start, leaving the phone in a bootloop.
    -->
    <privapp-permissions package="org.lineageos.settings.doogee">
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
</permissions>
