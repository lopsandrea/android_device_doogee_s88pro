#
# USB in recovery.
#
# AOSP recovery starts out assuming "legacy" USB: its init.rc does
# "setprop sys.usb.configfs 0" and then writes to /sys/class/android_usb/android0,
# which this kernel does not have. Here USB goes through configfs, as in
# Android, where sys.usb.configfs is 1 and the gadget is called musb-hdrc -- the driver says so:
#
#   drivers/usb/mtu3/mtu3_plat_v2.c:564   dev_set_name(dev, "musb-hdrc");
#
# and the running phone confirms it: /sys/class/udc holds a single entry,
# musb-hdrc.
#
# Without this file recovery shows perfectly well on screen but does not answer
# adb: no sideload, hence no way to install the zip.
#
# The configfs branch that bootable/recovery/etc/init.rc already has prepares
# the gadget -- idVendor, strings, ffs.adb, ffs.fastboot, configuration b.1 --
# but never binds it to the controller. AOSP leaves the UDC write to the device,
# and that is exactly what is missing. The legacy branch does do it
# ("write /sys/class/android_usb/android0/enable 1"), which explains why it
# works by itself on older devices and not here.

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller musb-hdrc

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct ${ro.recovery.usb.adb.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# sideload uses the same function as adb, so the f1 symlink is already in place
# and the one below does nothing: it stays because recovery can enter sideload
# without going through adb.
on property:sys.usb.config=sideload && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct ${ro.recovery.usb.adb.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "sideload"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# fastboot changes function, so the link has to be detached first: unbind the
# gadget from the controller, remove f1 and remake it. In the other order the
# kernel refuses the change, because an active gadget must not be touched.
on property:sys.usb.config=fastboot && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/idProduct ${ro.recovery.usb.fastboot.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "fastboot"
    symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    setprop sys.usb.state ${sys.usb.config}
