# L'USB della recovery.
#
# La recovery di AOSP parte dando per scontato l'USB "legacy": il suo init.rc
# fa "setprop sys.usb.configfs 0" e poi scrive su /sys/class/android_usb/android0,
# che questo kernel non ha. Qui l'USB passa da configfs, come in Android, dove
# sys.usb.configfs vale 1 e il gadget si chiama musb-hdrc -- lo dice il driver:
#
#   drivers/usb/mtu3/mtu3_plat_v2.c:564   dev_set_name(dev, "musb-hdrc");
#
# e lo conferma il telefono acceso, dove /sys/class/udc contiene una sola voce,
# musb-hdrc.
#
# Senza questo file la recovery si vede benissimo sullo schermo ma non risponde
# ad adb: niente sideload, quindi niente installazione dello zip.
#
# Il ramo configfs che bootable/recovery/etc/init.rc ha gia' prepara il gadget
# -- idVendor, stringhe, ffs.adb, ffs.fastboot, la configurazione b.1 -- ma non
# lo attacca mai al controller. La scrittura su UDC AOSP la lascia al device, ed
# e' esattamente quello che manca. Il ramo legacy invece la fa
# ("write /sys/class/android_usb/android0/enable 1"), il che spiega perche' sui
# device vecchi funziona da solo e qui no.

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller musb-hdrc

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct ${ro.recovery.usb.adb.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# sideload usa la stessa funzione di adb, quindi il collegamento f1 e' gia' al
# suo posto e il symlink qui sotto non fa nulla: si lascia perche' la recovery
# puo' entrare in sideload senza passare da adb.
on property:sys.usb.config=sideload && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct ${ro.recovery.usb.adb.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "sideload"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# fastboot cambia funzione, quindi il collegamento va staccato prima: si stacca
# il gadget dal controller, si toglie f1 e si rifa. Nell'altro ordine il kernel
# rifiuta la modifica, perche' un gadget attivo non si tocca.
on property:sys.usb.config=fastboot && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/idProduct ${ro.recovery.usb.fastboot.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "fastboot"
    symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    setprop sys.usb.state ${sys.usb.config}
