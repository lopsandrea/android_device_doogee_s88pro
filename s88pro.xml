<!--
  Local manifest for building the Doogee S88 Pro before the repos live under
  the LineageOS organisation.

  Copy it into .repo/local_manifests/ and then run repo sync:

      mkdir -p .repo/local_manifests
      cp device/doogee/s88pro/s88pro.xml .repo/local_manifests/
      repo sync

  Why it is needed, and why lineage.dependencies is not enough: roomservice.py
  builds the project name as "LineageOS/<repository>" and overrides that only
  for remotes starting with "aosp-", used for the kernel prebuilts
  (vendor/lineage/build/tools/roomservice.py, line 179). There is no way to
  point it at another owner. The local manifest, on the other hand, accepts the
  full name, because the "github" remote in the LineageOS manifest has
  fetch=".." and therefore points at the root of github.com.

  Once the repos move under LineageOS this file will no longer be needed:
  lineage.dependencies will do on its own, and is already written for that
  case.
-->
<manifest>
  <project path="device/doogee/s88pro"
           name="lopsandrea/android_device_doogee_s88pro"
           remote="github"
           revision="lineage-22.2" />

  <project path="vendor/doogee/s88pro"
           name="lopsandrea/android_vendor_doogee_s88pro"
           remote="github"
           revision="lineage-22.2" />

  <!--
    The kernel sources. BoardConfig builds the kernel from them, so they are
    required: the charter forbids shipping a prebuilt kernel. The image in
    prebuilt/ also comes from here, for anyone who wants to install without
    rebuilding.
  -->
  <project path="kernel/doogee/s88pro"
           name="lopsandrea/android_kernel_doogee_s88pro"
           remote="github"
           revision="lineage-22.2" />

  <!--
    The VNDK 29 snapshot, which the LineageOS 22.2 manifest no longer carries:
    Android 15 clears BOARD_VNDK_VERSION and PLATFORM_VNDK_VERSION, because the
    platform has no VNDK of its own any more (build/make/core/config.mk), and
    only v30 and above are left in the manifest. This vendor is Android 10,
    that is VNDK 29, and without those libraries its binaries do not link: the
    PureSoftKeymasterContext() constructor that /vendor/lib64/libkeymaster4.so
    needs lives only in /apex/com.android.vndk.v29.

    The revision is pinned to the tag LineageOS 21 took it from, so the build
    stays reproducible.
  -->
  <project path="prebuilts/vndk/v29"
           name="platform/prebuilts/vndk/v29"
           remote="aosp"
           revision="refs/tags/android-14.0.0_r67"
           clone-depth="1"
           groups="pdk" />
</manifest>
