cc_binary {
    name: "vendor.lineage.touch-service.s88pro",
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.touch-service.s88pro.rc"],
    // addService rejects an instance that no VINTF manifest declares.
    vintf_fragments: ["vendor.lineage.touch-service.s88pro.xml"],
    srcs: [
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.lineage.touch-V1-ndk",
    ],
    // Not vendor: the vendor image is the stock prebuilt one. See
    // BoardConfig.mk, BOARD_PREBUILT_VENDORIMAGE.
    system_ext_specific: true,
}
