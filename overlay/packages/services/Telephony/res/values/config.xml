<resources>
    <!--
         The device's default ImsService, for VoLTE: the package ImsResolver
         binds for MMTEL. It declares no android.telephony.ims.MMTEL_FEATURE
         metadata, so ImsResolver binds it and asks which features it supports
         (MMTEL and EMERGENCY_MMTEL on every slot).

         It only applies if ImsService has been prepared and installed: see the
         VoLTE section in device.mk. Without the package ImsResolver finds
         nothing and nothing changes.
    -->
    <string name="config_ims_mmtel_package" translatable="false">com.mediatek.ims</string>
</resources>
