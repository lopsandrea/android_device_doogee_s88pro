<resources>
    <!--
         Makes the hotspot interface be recognised.

         The vendor WiFi creates the access point on "ap0", as
         ro.vendor.wifi.sap.interface declares, but the AOSP default list holds
         only wlan, softap and ap_br_*. Matching none of them, the tethering
         service does not take the interface on: hostapd starts, the device
         associates and even completes the WPA handshake, but nobody assigns an
         address to ap0

             netd: interfaceGetCfg(ap0) -> {... ipv4Addr: 0.0.0.0 ...}

         and the client is left without an IP. The logs also show
         EthernetTracker taking care of ap0, a sign that the interface was not
         recognised for what it is.

         The original entries have to be repeated: an overlay replaces the
         whole array, and dropping them would break tethering on the other
         names.
    -->
    <string-array translatable="false" name="config_tether_wifi_regexs">
        <item>"wlan\\d"</item>
        <item>"softap\\d"</item>
        <item>"ap_br_wlan\\d"</item>
        <item>"ap_br_softap\\d"</item>
        <item>"ap\\d"</item>
    </string-array>
</resources>
