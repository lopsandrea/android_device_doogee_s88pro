<resources>
    <!--
         The hardware keys, for Settings > System > Buttons: the volume rocker
         (64), the orange key on the left of the case, which the key layout
         makes the assistant key (8), and the camera key below it (32). See
         rootdir/usr/keylayout/mtk-kpd.kl.
    -->
    <integer name="config_deviceHardwareKeys">104</integer>

    <!-- Any of them may wake the phone, if the user so chooses. -->
    <integer name="config_deviceHardwareWakeKeys">104</integer>

    <!--
         Prevent accidental wake-up: before a wake key turns the screen on, the
         proximity sensor is checked. It matters for double tap to wake, which
         the touchscreen's key layout sends as WAKEUP for this reason (see
         rootdir/usr/keylayout/mtk-tpd.kl); on by default, since double tap to
         wake is.
    -->
    <bool name="config_proximityCheckOnWake">true</bool>
    <bool name="config_proximityCheckOnWakeEnabledByDefault">true</bool>

    <!--
         Adds our key handler alongside the LineageOS one.

         PhoneWindowManager loads these classes at boot and hands them every
         key before delivering it to the foreground app. The two lists run in
         parallel, so order matters: the first path goes with the first class.

         The LineageParts entry has to be repeated, because an overlay replaces
         the whole array and dropping it would disable the gestures.
    -->
    <string-array name="config_deviceKeyHandlerLibs" translatable="false">
        <item>/system_ext/priv-app/LineageParts/LineageParts.apk</item>
        <item>/system_ext/priv-app/S88ProParts/S88ProParts.apk</item>
    </string-array>

    <string-array name="config_deviceKeyHandlerClasses" translatable="false">
        <item>org.lineageos.lineageparts.gestures.KeyHandler</item>
        <item>org.lineageos.settings.doogee.keys.KeyHandler</item>
    </string-array>
</resources>
