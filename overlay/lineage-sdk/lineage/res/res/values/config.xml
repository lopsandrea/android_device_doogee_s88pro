<resources>
    <!--
         The hardware keys, for Settings > System > Buttons: the volume rocker
         (64), the orange key on the left of the case, which the key layout
         makes the assistant key (8), and the camera key below it (32). See
         rootdir/usr/keylayout/mtk-kpd.kl.
    -->
    <integer name="config_deviceHardwareKeys">104</integer>

    <!-- Any of them may wake the phone, if the user so chooses. -->
    <integer name="config_deviceHardwareWakeKeys">104</integer>

    <!--
         Prevent accidental wake-up: before a wake key turns the screen on, the
         proximity sensor is checked. It matters for double tap to wake, which
         the touchscreen's key layout sends as WAKEUP for this reason (see
         rootdir/usr/keylayout/mtk-tpd.kl); on by default, since double tap to
         wake is.
    -->
    <bool name="config_proximityCheckOnWake">true</bool>
    <bool name="config_proximityCheckOnWakeEnabledByDefault">true</bool>

    <!--
         Two lights, one per setting (light/Lights.cpp): the RGB LED at the top
         of the front is the battery light (Settings > Battery > Battery
         light), the light strip around the rear cameras the notification
         light (Settings > Notifications > Notification light). RGB for
         notifications (1) and battery (2), pulsing (8), battery light (64).
         Brightness needs no flag of its own: with RGB, the framework scales
         the colour.
    -->
    <integer name="config_deviceLightCapabilities">75</integer>
</resources>
