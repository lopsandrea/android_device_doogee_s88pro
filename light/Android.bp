cc_binary {
    name: "android.hardware.light-service.s88pro",
    relative_install_path: "hw",
    init_rc: ["android.hardware.light-service.s88pro.rc"],
    // Required for the same reason as the vibrator's: addService rejects an
    // instance that no VINTF manifest declares.
    vintf_fragments: ["android.hardware.light-service.s88pro.xml"],
    srcs: [
        "Lights.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "android.hardware.light-V2-ndk",
    ],
    // Not vendor: the vendor image is the stock prebuilt one. See
    // BoardConfig.mk, BOARD_PREBUILT_VENDORIMAGE.
    system_ext_specific: true,
}
