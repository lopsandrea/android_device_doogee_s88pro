+// The memevents programs use BPF ring buffers, which bpfloader only loads on 5.10 and later
+// kernels: on older ones there is nothing to listen to, and vmstats is the expected path.
+static bool kernel_has_memevents() {
+    struct utsname u;
+    unsigned major = 0, minor = 0;
+
+    if (uname(&u) || sscanf(u.release, "%u.%u", &major, &minor) != 2) return true;
+    return major > 5 || (major == 5 && minor >= 10);
+}
