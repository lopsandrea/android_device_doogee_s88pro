@@ -477,6 +477,22 @@ struct ControllerImpl::impl {
   }
 
   void read_default_erroneous_data_reporting_handler(CommandCompleteView view) {
+    // The view has to be checked before anything is read from it, including
+    // GetCommandOpCode() below: a controller that claims to support this
+    // command and then answers UNKNOWN_HCI_COMMAND does so with a command
+    // status, not a command complete, and hci_layer hands that event to this
+    // handler anyway. Creating a CommandCompleteView from it yields an invalid
+    // view, and reading any field of an unvalidated view aborts the process
+    // with "assertion 'was_validated_' failed".
+    //
+    // The check below on complete_view already exists for controllers that lie
+    // about supporting the command (b/277589118); it is simply one line too
+    // late for the ones that lie in this particular way.
+    if (!view.IsValid()) {
+      log::error("invalid command complete view");
+      return;
+    }
+
     ASSERT(view.GetCommandOpCode() == OpCode::READ_DEFAULT_ERRONEOUS_DATA_REPORTING);
     auto complete_view = ReadDefaultErroneousDataReportingCompleteView::Create(view);
     // Check to see that the opcode was correct.
