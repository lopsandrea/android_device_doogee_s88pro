+  void read_default_erroneous_data_reporting_handler(CommandStatusOrCompleteView view) {
+    // This controller claims to support the command and then answers
+    // UNKNOWN_HCI_COMMAND -- with a command status, not a command complete.
+    //
+    // The argument is a status-or-complete on purpose. Taking a
+    // CommandCompleteView here is what tells hci_layer to expect a complete and
+    // nothing else, and when the status arrives it aborts the process before
+    // this handler is ever called:
+    //
+    //   hci_layer.cc:278 handle_command_response:
+    //     READ_DEFAULT_ERRONEOUS_DATA_REPORTING(0x0c5a) was not expecting
+    //     status event
+    //
+    // Asking for either lets the event through, and a status simply means the
+    // controller does not really have the command. Returning here is the right
+    // answer: erroneous data reporting is an optional audio quality feature,
+    // which is why every other failure below returns as well.
+    auto* complete = std::get_if<CommandCompleteView>(&view);
+    if (complete == nullptr) {
+      log::error("command status instead of command complete; not supported");
+      return;
+    }
+    if (!complete->IsValid()) {
+      log::error("invalid command complete view");
+      return;
+    }
+
+    ASSERT(complete->GetCommandOpCode() == OpCode::READ_DEFAULT_ERRONEOUS_DATA_REPORTING);
+    auto complete_view = ReadDefaultErroneousDataReportingCompleteView::Create(*complete);
     // Check to see that the opcode was correct.
     // log::assert_that is not used here to avoid process abort.
     // Some devices, such as mokey_go32, may claim to support it but do not
