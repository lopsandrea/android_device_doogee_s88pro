diff --git a/core/Makefile b/core/Makefile
index 849dac7074..c05f0ce0c9 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -6581,7 +6581,11 @@ ifdef BUILDING_USERDATA_IMAGE
 	$(hide) $(call package_files-copy-root, \
 	    $(TARGET_OUT_DATA),$(zip_root)/DATA)
 endif
-ifdef BUILDING_VENDOR_IMAGE
+# Vendor goes into the target-files even when it is a ready-made image:
+# without the directory, the OTA generator cannot find the partition and stops
+# with "vendor is in target super_..._partition_list but no BlockDifference
+# object is provided".
+ifneq (,$(BUILDING_VENDOR_IMAGE)$(BOARD_PREBUILT_VENDORIMAGE))
 	@# Contents of the vendor image
 	$(hide) $(call package_files-copy-root, \
 	    $(TARGET_OUT_VENDOR),$(zip_root)/VENDOR)
@@ -6714,6 +6718,52 @@ endif
 ifdef BOARD_PREBUILT_VENDORIMAGE
 	$(hide) mkdir -p $(zip_root)/IMAGES
 	$(hide) cp $(INSTALLED_VENDORIMAGE_TARGET) $(zip_root)/IMAGES/
+	@# A ready-made image has to be treated as non-sparse.
+	@#
+	@# generate-image-prop-dictionary writes "<part>_disable_sparse=true"
+	@# when the partition has no declared size, but it is only called for
+	@# the partitions the build constructs: with
+	@# BOARD_PREBUILT_VENDORIMAGE that pass never happens and the flag is missing.
+	@#
+	@# Without it, GetUserImage takes the sparse branch and demands two things
+	@# that do not exist here -- the block map next to the image and every file
+	@# of the map present in the target-files:
+	@#   assert os.path.exists(path) and os.path.exists(mappath)
+	@#   AssertionError: Failed to find the ZIP entry for ...
+	@# With the flag it just reads the image, which is what we want.
+	$(hide) echo "vendor_disable_sparse=true" >> $(zip_root)/META/misc_info.txt
+	@# The non-sparse branch too insists the block map exists next to the
+	@# image, even though it never reads it:
+	@#   assert os.path.exists(path) and os.path.exists(mappath)
+	@#   return images.FileImage(path, ...)
+	@# e2fsdroid derives it from the image without touching it.
+	$(hide) $(HOST_OUT_EXECUTABLES)/e2fsdroid -e \
+	    -B $(zip_root)/IMAGES/vendor.map $(zip_root)/IMAGES/vendor.img
+	@# The VINTF metadata this ROM declares, not what the image happens to
+	@# carry. ota_from_target_files runs checkvintf over the package, and
+	@# without these it stops on
+	@#   No device manifest file from device or from update package
+	@#
+	@# Pulling them out of the prebuilt image instead looked more honest --
+	@# it is the vendor we actually ship -- but it is not: the image also
+	@# holds fragments this device deliberately leaves out, and its manifest
+	@# declares an FCM version whose framework matrix Android no longer
+	@# ships. DEVICE_MANIFEST_FILE and DEVICE_MATRIX_FILE are what the
+	@# device tree declares, and what check_vintf_all already checks the
+	@# tree against, so the package and the build agree.
+	$(hide) mkdir -p $(zip_root)/VENDOR/etc/vintf/manifest
+	$(hide) cp $(firstword $(DEVICE_MANIFEST_FILE)) \
+	    $(zip_root)/VENDOR/etc/vintf/manifest.xml
+	$(hide) $(foreach f,$(wordlist 2,999,$(DEVICE_MANIFEST_FILE)),\
+	    cp $(f) $(zip_root)/VENDOR/etc/vintf/manifest/;)
+	$(hide) cp $(DEVICE_MATRIX_FILE) \
+	    $(zip_root)/VENDOR/etc/vintf/compatibility_matrix.xml
+	@# The kernel FCM version, which the device manifest cannot state on its
+	@# own: see the comment in the device tree.
+	$(hide) if [ -f $(TARGET_DEVICE_DIR)/vintf/kernel_fcm.xml ]; then \
+	    cp $(TARGET_DEVICE_DIR)/vintf/kernel_fcm.xml \
+	       $(zip_root)/VENDOR/etc/vintf/manifest/; \
+	fi
 endif
 ifdef BOARD_PREBUILT_PRODUCTIMAGE
 	$(hide) mkdir -p $(zip_root)/IMAGES
