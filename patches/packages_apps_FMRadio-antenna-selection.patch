+        // Picks the antenna path on devices with no headphone jack. Elsewhere
+        // the HEADSET_PLUG broadcast takes care of it; here it never arrives,
+        // and without this call the chip stays on the default value. 0 is the
+        // long antenna (the cable in the connector), 1 the short internal one;
+        // which of the two receives better depends on the phone, so the value
+        // can be changed on the fly with
+        //   setprop persist.vendor.fm.antenna 0
+        if (FmUtils.hasBuiltInFmAntennaSupport()) {
+            int antenna = SystemProperties.getInt("persist.vendor.fm.antenna", 1);
+            Log.d(TAG, "powerUp, switchAntenna " + antenna);
+            FmNative.switchAntenna(antenna);
+        }
