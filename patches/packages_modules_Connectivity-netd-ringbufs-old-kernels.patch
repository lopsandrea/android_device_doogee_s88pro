+        /**
+         * Whether the kernel has netd's BPF ring buffers (local network note ops and loopback
+         * access). netd.o creates them only on 5.10 and later (ring buffers came with 5.8), and
+         * opening a missing ring buffer aborts system_server.
+         */
+        public boolean hasNetdRingbufs() {
+            final String[] version = android.system.Os.uname().release.split("[.-]", 3);
+            try {
+                final int major = Integer.parseInt(version[0]);
+                final int minor = Integer.parseInt(version[1]);
+                return major > 5 || (major == 5 && minor >= 10);
+            } catch (NumberFormatException | ArrayIndexOutOfBoundsException e) {
+                return true;
+            }
+        }
+
