diff --git a/config/BoardConfigKernel.mk b/config/BoardConfigKernel.mk
index 4c2a268..6ee0f91 100644
--- a/config/BoardConfigKernel.mk
+++ b/config/BoardConfigKernel.mk
@@ -189,6 +189,26 @@ else
     TOOLS_PATH_OVERRIDE += PATH=$(BUILD_TOP)/prebuilts/tools-lineage/$(HOST_PREBUILT_TAG)/bin:$(TARGET_KERNEL_CLANG_PATH)/bin:$$PATH
 endif
 
+# Le flag aggiuntive del device valgono anche qui.
+#
+# TARGET_KERNEL_ADDITIONAL_FLAGS finora veniva applicata solo in
+# vendor/lineage/build/tasks/kernel.mk, che make legge dopo i BoardConfig.
+# Va bene per il kernel, che si costruisce in quella fase, ma non per i moduli
+# soong: lineage_generator (generated_kernel_includes, in
+# vendor/lineage/build/soong/Android.bp) usa $(KERNEL_MAKE_FLAGS) com'e' al
+# momento dell'esportazione verso soong, cioe' senza.
+#
+# Su un kernel 4.14 la differenza e' fatale: senza HOSTCFLAGS="-fuse-ld=lld"
+# clang linka gli strumenti host con "ld", che soong vieta apposta
+# (build/soong/ui/build/paths/config.go: "ld": Forbidden), e headers_install
+# muore con
+#   clang-14: error: unable to execute command: Executable "ld" doesn't exist!
+# Il kernel 4.14 non puo' cavarsela con HOSTLDFLAGS, che Kbuild ha imparato a
+# usare solo dalla 4.18.
+ifneq ($(TARGET_KERNEL_ADDITIONAL_FLAGS),)
+    KERNEL_MAKE_FLAGS += $(TARGET_KERNEL_ADDITIONAL_FLAGS)
+endif
+
 # Set DTBO image locations so the build system knows to build them
 ifeq (true,$(filter true, $(TARGET_NEEDS_DTBOIMAGE) $(BOARD_KERNEL_SEPARATED_DTBO)))
     TARGET_KERNEL_DTBO_PREFIX ?=
